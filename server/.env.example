NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=12h
EMPLOYEE_REGISTRATION_ENABLED=true
DEFAULT_ORG_NAME=BrandGuard Workspace
PRIVATE_STORAGE_DIR=./private_uploads
COOKIE_DOMAIN=

# Temporary values used only by the one-time initial Admin provisioning script.
# ADMIN_NAME=Organisation Administrator
# ADMIN_EMAIL=admin@your-organisation.com
# ADMIN_PASSWORD=Use-A-Unique-14-Character-Or-Longer-Secret!

# Optional AI analysis and document-scoped conversation. Keys are server-only; unset/unavailable providers use deterministic fallback where supported.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
